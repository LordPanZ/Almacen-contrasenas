{
  "name": "cerbero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cerbero (contraseñas) y Arca (documentos): dos aplicaciones independientes de conocimiento cero",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "cerbero": "node --experimental-strip-types apps/cli/src/main.ts",
    "typecheck:apps": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/arca/tsconfig.json && tsc --noEmit -p apps/extension/tsconfig.json",
    "construir:cerbero": "node scripts/construir-sitio.mjs cerbero",
    "construir:arca": "node scripts/construir-sitio.mjs arca",
    "construir:sitio": "node scripts/construir-sitio.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
