{
  "manifest_version": 3,
  "name": "Cerbero",
  "version": "0.1.0",
  "description": "Almacén de contraseñas de conocimiento cero. Solo rellena cuando el origen coincide de verdad.",
  "permissions": ["storage", "tabs", "alarms", "clipboardWrite"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "fondo.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cerbero"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["contenido.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
